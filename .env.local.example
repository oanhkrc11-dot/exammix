# Supabase renamed its API key system — newer projects show "Publishable
# key" / "Secret key" in the dashboard instead of the old "anon key" /
# "service role key" names. They're functionally interchangeable with this
# code; just paste whichever your project's dashboard shows into the
# matching variable below (Project Settings → API Keys).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# "anon key" (legacy) or "Publishable key" (new) — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# "service role key" (legacy) or "Secret key" (new) — server-only, never
# expose to the client. Used by the admin area to list/suspend users via the
# Supabase Auth Admin API. If you don't see one yet, create it under
# Project Settings → API Keys → Secret keys.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
